// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum KycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  BET
  PAYOUT
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum MatchStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
  POSTPONED
}

enum StreamType {
  YOUTUBE
  HLS
  IFRAME
  RTMP
}

enum RoomStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum RoomParticipantRole {
  HOST
  LISTENER
}

enum MarketType {
  MATCH_WINNER
  OVER_UNDER
  HANDICAP
  BOTH_TEAMS_TO_SCORE
  CORRECT_SCORE
  FIRST_GOALSCORER
  ASIAN_HANDICAP
}

enum MarketStatus {
  OPEN
  SUSPENDED
  SETTLED
  CANCELLED
}

enum BetStatus {
  PENDING
  WON
  LOST
  VOID
  CASHED_OUT
}

// ─── MODELS ───────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  phone        String?   @unique
  passwordHash String
  role         UserRole  @default(USER)
  kycStatus    KycStatus @default(PENDING)
  displayName  String?
  avatarUrl    String?
  totpSecret   String?   // null = 2FA not enabled, only admins require it
  isFrozen     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  wallet        Wallet?
  bets          Bet[]
  roomParticipants RoomParticipant[]
  hostedRooms   MatchRoom[]   @relation("HostedRooms")
  auditLogs     AuditLog[]
  kycDocuments  KycDocument[]

  @@index([email])
  @@index([phone])
  @@index([role])
}

model KycDocument {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType    String   // PASSPORT, NATIONAL_ID, DRIVERS_LICENSE
  fileUrl    String
  status     KycStatus @default(SUBMITTED)
  reviewedAt DateTime?
  reviewNote String?
  createdAt  DateTime @default(now())
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance       Decimal  @default(0) @db.Decimal(18, 2)
  lockedBalance Decimal  @default(0) @db.Decimal(18, 2) // reserved for pending bets
  currency      String   @default("USD") @db.VarChar(3)
  updatedAt     DateTime @updatedAt

  transactions  Transaction[]
}

model Transaction {
  id             String            @id @default(uuid())
  walletId       String
  wallet         Wallet            @relation(fields: [walletId], references: [id])
  type           TransactionType
  amount         Decimal           @db.Decimal(18, 2)
  status         TransactionStatus @default(PENDING)
  reference      String?           // external reference (Stripe payment intent id, etc.)
  idempotencyKey String?           @unique
  metadata       Json?
  createdAt      DateTime          @default(now())

  @@index([walletId])
  @@index([idempotencyKey])
  @@index([createdAt])
}

model Sport {
  id      String  @id @default(uuid())
  name    String  @unique
  slug    String  @unique
  iconUrl String?

  matches Match[]
}

model Match {
  id         String      @id @default(uuid())
  sportId    String
  sport      Sport       @relation(fields: [sportId], references: [id])
  teamA      String
  teamB      String
  startTime  DateTime
  status     MatchStatus @default(UPCOMING)
  streamUrl  String?
  streamType StreamType?
  scoreA     Int?
  scoreB     Int?
  venue      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  rooms   MatchRoom[]
  markets Market[]

  @@index([status])
  @@index([startTime])
  @@index([sportId])
}

model MatchRoom {
  id               String     @id @default(uuid())
  matchId          String
  match            Match      @relation(fields: [matchId], references: [id])
  hostId           String
  host             User       @relation("HostedRooms", fields: [hostId], references: [id])
  livekitRoomName  String     @unique
  status           RoomStatus @default(SCHEDULED)
  startedAt        DateTime?
  endedAt          DateTime?
  participantCount Int        @default(0)
  createdAt        DateTime   @default(now())

  participants RoomParticipant[]

  @@index([matchId])
  @@index([status])
}

model RoomParticipant {
  id       String              @id @default(uuid())
  roomId   String
  room     MatchRoom           @relation(fields: [roomId], references: [id])
  userId   String
  user     User                @relation(fields: [userId], references: [id])
  role     RoomParticipantRole @default(LISTENER)
  joinedAt DateTime            @default(now())
  leftAt   DateTime?

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

model Market {
  id               String       @id @default(uuid())
  matchId          String
  match            Match        @relation(fields: [matchId], references: [id])
  type             MarketType
  label            String
  status           MarketStatus @default(OPEN)
  settledAt        DateTime?
  winningSelection String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  odds Odds[]
  bets Bet[]

  @@index([matchId])
  @@index([status])
}

model Odds {
  id        String   @id @default(uuid())
  marketId  String
  market    Market   @relation(fields: [marketId], references: [id])
  selection String
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  // Snapshot history — keep old rows for audit; only isActive=true rows are live
  bets Bet[]

  @@index([marketId])
  @@index([isActive])
}

model Bet {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  marketId        String
  market          Market    @relation(fields: [marketId], references: [id])
  oddsId          String    // snapshot of the odds at bet time
  odds            Odds      @relation(fields: [oddsId], references: [id])
  selection       String    // denormalized for history
  oddsPrice       Decimal   @db.Decimal(10, 2) // snapshot price — NEVER retroactively changed
  stake           Decimal   @db.Decimal(18, 2)
  potentialPayout Decimal   @db.Decimal(18, 2)
  status          BetStatus @default(PENDING)
  cashOutAmount   Decimal?  @db.Decimal(18, 2)
  idempotencyKey  String    @unique // prevent double-submit
  placedAt        DateTime  @default(now())
  settledAt       DateTime?

  @@index([userId])
  @@index([marketId])
  @@index([status])
  @@index([idempotencyKey])
  @@index([placedAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String   // e.g. "SETTLE_MARKET", "FREEZE_USER", "UPDATE_ODDS"
  entityType String   // e.g. "Market", "User", "Bet"
  entityId   String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
