# =============================================================================
# SPORTS BETTING PLATFORM — ROOT ENV EXAMPLE
# Copy to .env in each relevant app/package and fill in real values.
# =============================================================================

# --- DATABASE ---
DATABASE_URL="postgresql://betting:betting@localhost:5432/bettingdb?schema=public"

# --- REDIS ---
REDIS_URL="redis://localhost:6379"

# --- JWT ---
JWT_ACCESS_SECRET="CHANGE_ME_access_secret_at_least_32_chars"
JWT_REFRESH_SECRET="CHANGE_ME_refresh_secret_at_least_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- ARGON2 (password hashing) ---
# No extra config needed; defaults are Argon2id with recommended params.

# --- LIVEKIT ---
LIVEKIT_URL="ws://localhost:7880"                          # local docker
# LIVEKIT_URL="wss://your-project.livekit.cloud"           # LiveKit Cloud
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="devsecret_at_least_32_chars_long_ok"

# --- STRIPE (Payment adapter) ---
STRIPE_SECRET_KEY="sk_test_XXXXXXXXXXXXXXXXXXXXXX"
STRIPE_WEBHOOK_SECRET="whsec_XXXXXXXXXXXXXXXXXXXXX"

# --- EMAIL (Nodemailer / Resend stub) ---
EMAIL_FROM="noreply@bettingplatform.com"
RESEND_API_KEY="re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# --- TOTP (2FA for admin) ---
TOTP_ISSUER="BettingPlatform"

# --- API SERVER ---
API_PORT=4000
API_HOST="0.0.0.0"
NODE_ENV="development"

# --- NEXTJS APPS ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="http://localhost:4000"
NEXT_PUBLIC_LIVEKIT_URL="ws://localhost:7880"

# --- CORS ---
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# --- SENTRY (optional) ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
